# ── Runtime ──────────────────────────────────────────────
NODE_ENV=production
PORT=4300

# ── Turso database ───────────────────────────────────────
DATABASE_URL=libsql://your-db.turso.io
DATABASE_AUTH_TOKEN=your-turso-token

# ── Cloudflare R2 / S3 storage ──────────────────────────
S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
S3_BUCKET=proview
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── AI gateway (Gemini grading) ──────────────────────────
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# ── Auth ─────────────────────────────────────────────────
BETTER_AUTH_SECRET=change-me
WEBSITE_URL=https://your-app.up.railway.app

# ── Database connection tuning (optional — defaults shown) ──────────────
# Separate connection pools for students / admin console / background work,
# so one cannot starve the others. Set DB_LANES=off to fall back to one pool.
# DB_LANES=on
# DB_CONCURRENCY_STUDENT=48
# DB_CONCURRENCY_ADMIN=16
# DB_CONCURRENCY_BACKGROUND=8
# DB_CONCURRENCY=64              # only used when DB_LANES=off
# Abort any single database request after this many ms (0 = never; not advised).
# DB_STATEMENT_TIMEOUT_MS=15000
# How long a staff login check is remembered, in ms.
# AUTH_CACHE_MS=10000
